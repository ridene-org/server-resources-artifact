# ============================================================================
# Platform Infrastructure Environment Variables
# ============================================================================
# Copy this file to .env and update values for your deployment.
# These variables are used by docker-compose.yaml to configure services.
# ============================================================================

# ----------------------------------------------------------------------------
# PostgreSQL Configuration
# ----------------------------------------------------------------------------
# Default admin user for PostgreSQL. Create separate databases/users per app.
POSTGRES_USER=platform_admin

# Strong password for PostgreSQL admin. CHANGE THIS BEFORE DEPLOYING!
POSTGRES_PASSWORD=ChangeMe_Platform2024!

# Default database created on first startup.
POSTGRES_DB=platform

# Port exposed on host for external connections.
POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# Valkey (Redis) Configuration
# ----------------------------------------------------------------------------
# Maximum memory Valkey can use before evicting keys.
VALKEY_MAXMEMORY=256mb

# Port exposed on host for external connections.
VALKEY_PORT=6379

# ----------------------------------------------------------------------------
# RabbitMQ Configuration
# ----------------------------------------------------------------------------
# Default admin user for RabbitMQ management.
RABBITMQ_USER=platform_admin

# Strong password for RabbitMQ admin. CHANGE THIS BEFORE DEPLOYING!
RABBITMQ_PASS=ChangeMe_Platform2024!

# Default virtual host. Create separate vhosts per application.
RABBITMQ_VHOST=platform

# AMQP port for message publishing/consuming.
RABBITMQ_AMQP_PORT=5672

# Management UI port (http://localhost:15672).
RABBITMQ_MGMT_PORT=15672
